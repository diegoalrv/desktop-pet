{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Pet",
  "version": "0.1.0",
  "identifier": "xyz.spadelab.pet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "pet",
        "width": 160,
        "height": 196,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "panel",
        "title": "panel",
        "url": "index.html",
        "width": 360,
        "height": 640,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "focus": true
      },
      {
        "label": "settings",
        "title": "Ajustes",
        "url": "index.html",
        "width": 460,
        "height": 640,
        "visible": false,
        "resizable": true,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "tasks",
        "title": "Gestor de tareas",
        "url": "index.html",
        "width": 980,
        "height": 640,
        "minWidth": 640,
        "minHeight": 400,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:pet.db"
      ]
    }
  }
}